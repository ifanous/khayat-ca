{
  "name": "khayat-ca",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "pnpm run build-reviews && astro build",
    "build-reviews": "node scripts/build-google-reviews.ts",
    "dev": "pnpm run build-reviews && astro dev",
    "preview": "astro preview"
  },
  "prettier": {
    "attributeGroups": [
      "^(class|id|name)$",
      "^(for|form|list)$",
      "^(type|value|href|src|srcset|alt|title|rel|target|method|action|enctype)$",
      "^data-",
      "^role$",
      "^aria-",
      "^tabindex$",
      "^(placeholder|readonly|disabled|required|autofocus|autocomplete|min|max|step|minlength|maxlength|pattern|multiple|checked|selected)$",
      "^(width|height|controls|autoplay|loop|muted|preload|poster)$",
      "^(contenteditable|draggable|hidden|spellcheck|translate|download|loading (lazy/eager)|async|defer)$",
      "^property$",
      "^content$",
      "style",
      "^on",
      "$DEFAULT"
    ],
    "attributeSort": "ASC",
    "cssDeclarationSorterOrder": "frakto",
    "importOrder": [
      "^astro(/|:)",
      "",
      "^@astrojs/",
      "",
      "<BUILTIN_MODULES>",
      "",
      "<THIRD_PARTY_MODULES>",
      "",
      "^(?!.*[.]css$)[./].*$",
      "",
      ".css$"
    ],
    "importOrderSafeSideEffects": [
      ".css$"
    ],
    "importOrderTypeScriptVersion": "6.0.0",
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-css-order",
      "prettier-plugin-tailwindcss",
      "@ianvs/prettier-plugin-sort-imports",
      "@xeonlink/prettier-plugin-organize-attributes"
    ]
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.107",
    "@iconify-json/simple-icons": "^1.2.82",
    "astro": "^6.3.3",
    "astro-icon": "^1.1.5",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@biomejs/biome": "^2.4.15",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@iconify-json/mdi": "^1.2.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.0",
    "@xeonlink/prettier-plugin-organize-attributes": "^1.1.0",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "fallow": "^2.74.0",
    "netlify-cli": "^24.11.3",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "sharp": "^0.34.5",
    "sort-package-json": "^3.6.1",
    "typescript-eslint": "^8.59.3"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
