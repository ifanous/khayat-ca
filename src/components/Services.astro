---
import Service from "./Service.astro";

const services = [
  {
    name: "Permanent Residence",
    description:
      "I help you pick the pathway that fits your profile, then build a file that holds up to an officer's scrutiny.",
    features: [
      "Express Entry & Provincial Nominee Program (PNP) applications",
      "Spousal, family & parents/grandparents sponsorship",
      "PR card renewal, PRTD & humanitarian applications",
    ],
    icon: "lucide:home",
  },
  {
    name: "Temporary Residence",
    description:
      "Timing is where temporary permits go wrong. A lapsed status or a late extension follows you into every later application, so I keep your status intact while we work toward the next step.",
    features: [
      "Visitor visa, super visa & visitor record extensions",
      "Study permit, PGWP & study permit extensions",
      "Work permit, LMIA & open work permit applications",
    ],
    icon: "lucide:plane",
  },
  {
    name: "Citizenship",
    description:
      "Citizenship is usually the last step of a long road. I make sure the final application, and the residency math behind it, is done right the first time.",
    features: [
      "Citizenship application preparation, submission & IRCC follow-up",
      "Citizenship certificates, proof of citizenship & passport applications",
      "Document review, application support & IRCC communication",
    ],
    icon: "lucide:badge-check",
  },
  {
    name: "Refugee Protection",
    description:
      "A refugee claim is decided on your story and your evidence. I prepare both carefully, represent you before the IRB, and stay with your file through to protected person permanent residence.",
    features: [
      "Refugee claim preparation, filing & hearing support",
      "Protected person permanent residence & travel documents",
      "CBSA deferral requests, IRB/IRCC forms & evidence disclosure",
    ],
    icon: "lucide:shield",
  },
];
---

<section
  class="bg-background py-20 lg:py-28"
  id="services"
  aria-labelledby="services-heading"
>
  <div class="max-w-container mx-auto px-6">
    <div class="mb-16 text-center">
      <h2
        class="text-primary mb-4 text-3xl font-bold md:text-4xl lg:text-5xl"
        id="services-heading"
      >
        What I work on
      </h2>
      <p class="text-secondary mx-auto max-w-2xl text-xl">
        My practice covers the four main areas of Canadian immigration. I handle
        every file myself from start to finish.
      </p>
    </div>

    <ol
      class="border-border-custom mx-auto max-w-5xl list-none border-t p-0"
      aria-label="Immigration services"
    >
      {services.map((service) => <Service {...service} />)}
    </ol>
  </div>
</section>
