---
import { Icon } from "astro-icon/components";
---

<section class="bg-muted py-20" id="contact" aria-labelledby="contact-heading">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-16 text-center">
      <h2
        class="text-primary text-3xl font-bold md:text-4xl lg:text-5xl"
        id="contact-heading"
      >
        Request a consultation
      </h2>
    </div>

    <div class="mx-auto max-w-3xl">
      <form
        class="surface-hairline p-5 sm:p-8"
        id="contact-form"
        name="contact-form"
        method="POST"
        data-netlify="true"
        data-netlify-recaptcha="true"
        netlify-honeypot="bot-field"
      >
        <div class="mb-8">
          <h3 class="text-primary text-2xl font-semibold">Send a message</h3>
        </div>

        <div class="hidden" aria-hidden="true">
          <input
            id="bot-field"
            name="bot-field"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <label class="text-primary mb-2 block font-semibold" for="name"
              >Full Name *</label
            >
            <input
              class="border-field-border bg-background text-primary focus:ring-accent min-h-12 w-full rounded-lg border px-4 py-4 transition-colors duration-150 focus:ring-2 focus:outline-none"
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              required
            />
          </div>
          <div>
            <label class="text-primary mb-2 block font-semibold" for="email"
              >Email Address *</label
            >
            <input
              class="border-field-border bg-background text-primary focus:ring-accent min-h-12 w-full rounded-lg border px-4 py-4 transition-colors duration-150 focus:ring-2 focus:outline-none"
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              spellcheck="false"
              autocapitalize="none"
            />
          </div>
        </div>

        <div class="mb-6">
          <label class="text-primary mb-2 block font-semibold" for="service">
            Service Interest{" "}
            <span class="text-secondary font-normal">(optional)</span>
          </label>
          <select
            class="border-field-border bg-background text-primary focus:ring-accent min-h-12 w-full rounded-lg border px-4 py-4 transition-colors duration-150 focus:ring-2 focus:outline-none"
            id="service"
            name="service"
          >
            <option value="">Select a service...</option>
            <option value="Permanent Residence">Permanent Residence</option>
            <option value="Temporary Residence">Temporary Residence</option>
            <option value="Citizenship">Citizenship</option>
            <option value="Refugee Protection">Refugee Protection</option>
            <option value="General Consultation">General Consultation</option>
          </select>
        </div>

        <div class="mb-6">
          <label class="text-primary mb-2 block font-semibold" for="message"
            >Tell me about your situation *</label
          >
          <textarea
            class="border-field-border bg-background text-primary focus:ring-accent min-h-30 w-full resize-y rounded-lg border px-4 py-4 transition-colors duration-150 focus:ring-2 focus:outline-none"
            id="message"
            name="message"
            placeholder="Share where you are in the process, your timeline, and what you're hoping to sort out."
            required
            rows="5"></textarea>
        </div>

        <div data-netlify-recaptcha="true"></div>

        <p
          class="text-secondary mb-4 min-h-6 text-sm"
          id="contact-form-status"
          aria-atomic="true"
          aria-live="polite"
        >
        </p>

        <button
          class="btn-primary focus-ring inline-flex min-h-13 w-full cursor-pointer items-center justify-center gap-2 rounded-lg border-2 border-transparent px-4 py-4 font-semibold text-white transition-all duration-200 disabled:cursor-not-allowed disabled:opacity-60"
          id="submit-btn"
          type="submit"
        >
          <span>Send Message</span>
          <Icon
            class="h-4.5 w-4.5 shrink-0"
            name="lucide:send"
            aria-hidden="true"
          />
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  type Grecaptcha = {
    getResponse: (widgetId?: number) => string;
    reset: (widgetId?: number) => void;
  };

  const contactForm = document.querySelector<HTMLFormElement>("#contact-form");

  if (contactForm) {
    const submitButton = contactForm.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    const statusMessage = contactForm.querySelector<HTMLParagraphElement>(
      "#contact-form-status",
    );

    const getCaptchaResponse = (): string => {
      const grecaptcha = getGrecaptcha();

      if (grecaptcha && typeof grecaptcha.getResponse === "function") {
        try {
          return grecaptcha.getResponse() ?? "";
        } catch {
          // Widget not yet rendered; fall through to DOM lookup.
        }
      }

      const responseField = contactForm.querySelector<HTMLTextAreaElement>(
        'textarea[name="g-recaptcha-response"]',
      );

      return responseField?.value ?? "";
    };

    const getGrecaptcha = (): Grecaptcha | undefined =>
      (window as unknown as { grecaptcha?: Grecaptcha }).grecaptcha;

    const setSubmitEnabled = (enabled: boolean) => {
      if (!submitButton) return;
      submitButton.disabled = !enabled;
    };

    const resetCaptcha = () => {
      try {
        getGrecaptcha()?.reset();
      } catch {
        // ignore — widget may not be ready
      }
    };

    let isSubmitting = false;

    const syncCaptchaState = () => {
      const hasCaptchaResponse = getCaptchaResponse().length > 0;

      setSubmitEnabled(!isSubmitting && hasCaptchaResponse);
    };

    // Set the initial state before polling. The HTML button stays usable for
    // Netlify's no-JavaScript fallback, then JS gates it on verification.
    syncCaptchaState();

    // reCAPTCHA changes the response field's value property without emitting a
    // DOM event, so periodically sync both successful and expired challenges.
    window.setInterval(syncCaptchaState, 250);

    contactForm.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (isSubmitting) return;

      if (!submitButton || !statusMessage) return;

      if (!getCaptchaResponse()) {
        setSubmitEnabled(false);

        return;
      }

      const formData = new FormData(contactForm);

      isSubmitting = true;
      contactForm.setAttribute("aria-busy", "true");
      submitButton.disabled = true;
      statusMessage.textContent = "Sending your message...";

      let feedbackMessage = "Your message has been sent successfully.";

      try {
        const response = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(
            Array.from(formData.entries()) as [string, string][],
          ).toString(),
        });

        if (!response.ok) {
          throw new Error(
            `Form submission failed with status ${response.status}`,
          );
        }

        contactForm.reset();
      } catch {
        feedbackMessage = "Your message failed to send. Please try again.";
      }

      resetCaptcha();
      contactForm.setAttribute("aria-busy", "false");
      statusMessage.textContent = feedbackMessage;
      isSubmitting = false;
      syncCaptchaState();
    });
  }
</script>
