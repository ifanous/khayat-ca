---
import { Icon } from "astro-icon/components";

import reviewsData from "../data/google-reviews.json";
import type { ReviewsData } from "../types/reviews";
import { byNewestFirst } from "../utils/reviews";
import ReviewCard from "./ReviewCard.astro";

const GOOGLE_REVIEWS_URL =
  "https://www.google.com/search?q=Brigitte+Khayat+-+Immigration+%26+Refugee+Consulting+Inc.+Reviews";

const { reviews, summary } = reviewsData as ReviewsData;

/** All reviews sorted newest-first, rendered at build time. */
const sortedReviews = [...reviews].sort(byNewestFirst);
const ratingRounded = Math.round(summary.averageRating);
---

<section
  class="bg-muted overflow-x-clip py-20"
  id="reviews"
  aria-labelledby="reviews-heading"
>
  <div class="max-w-container mx-auto px-6">
    <div class="mb-16 text-center">
      <h2
        class="text-primary mb-8 text-3xl font-bold md:text-4xl lg:text-5xl"
        id="reviews-heading"
      >
        What clients say
      </h2>
      <div class="surface-hairline mt-8 inline-block p-6">
        <div class="mb-4 flex items-center gap-4">
          <div class="text-accent text-4xl font-bold" aria-hidden="true">
            {summary.averageRating.toFixed(1)}
          </div>
          <div>
            <div
              class="text-star mb-1 flex gap-0.5"
              role="img"
              aria-label={`Rated ${summary.averageRating.toFixed(1)} out of 5 stars`}
            >
              {
                Array.from({ length: ratingRounded }).map(() => (
                  <Icon class="h-5 w-5" name="mdi:star" aria-hidden="true" />
                ))
              }
            </div>
            <p class="text-secondary text-sm">
              Based on {summary.reviewCount} Google reviews
            </p>
          </div>
        </div>
        <a
          class="text-accent focus-ring inline-flex items-center gap-1.5 font-semibold underline decoration-2 underline-offset-2"
          href={GOOGLE_REVIEWS_URL}
          rel="noopener noreferrer"
          target="_blank"
          aria-label="View all reviews on Google (opens in a new tab)"
        >
          View all reviews
          <Icon
            class="h-4 w-4"
            name="lucide:external-link"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>

    <!-- Carousel -->
    <div
      class="relative flex flex-col"
      role="region"
      aria-label="Client reviews"
      aria-roledescription="carousel"
    >
      <!-- Controls come first in the tab order but render below the mobile track. -->
      <div class="order-1 mt-4 flex justify-center gap-4 md:contents">
        <button
          class="surface-hairline focus-ring text-primary hover:text-accent hover:border-primary/20 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full! transition-colors duration-200 disabled:pointer-events-none disabled:cursor-default disabled:opacity-30 md:absolute md:top-1/2 md:left-0 md:z-10 md:-translate-x-1/2 md:-translate-y-1/2"
          id="carousel-prev"
          type="button"
          aria-label="Previous reviews"
          disabled
        >
          <Icon class="h-5 w-5" name="lucide:chevron-left" aria-hidden="true" />
        </button>
        <button
          class="surface-hairline focus-ring text-primary hover:text-accent hover:border-primary/20 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full! transition-colors duration-200 disabled:pointer-events-none disabled:cursor-default disabled:opacity-30 md:absolute md:top-1/2 md:right-0 md:z-10 md:translate-x-1/2 md:-translate-y-1/2"
          id="carousel-next"
          type="button"
          aria-label="Next reviews"
        >
          <Icon
            class="h-5 w-5"
            name="lucide:chevron-right"
            aria-hidden="true"
          />
        </button>
      </div>

      <!-- Scroll track -->
      <ul
        class="flex min-w-0 snap-x snap-mandatory scrollbar-none gap-8 overflow-x-auto scroll-smooth pb-4"
        id="reviews-track"
        aria-label="Reviews list"
      >
        {
          sortedReviews.map((review, index) => (
            <ReviewCard
              index={index}
              review={review}
              total={sortedReviews.length}
            />
          ))
        }
      </ul>

      <!-- Mobile swipe hint. -->
      <p
        class="text-secondary order-2 mt-4 flex items-center justify-center gap-2 text-xs md:hidden"
        aria-hidden="true"
      >
        <Icon
          class="h-3.5 w-3.5"
          name="lucide:move-horizontal"
          aria-hidden="true"
        />
        Swipe to see more
      </p>
    </div>
  </div>
</section>

<script>
  const reviewsTrack = document.getElementById(
    "reviews-track",
  ) as HTMLUListElement | null;
  const previousReviewButton = document.getElementById(
    "carousel-prev",
  ) as HTMLButtonElement | null;
  const nextReviewButton = document.getElementById(
    "carousel-next",
  ) as HTMLButtonElement | null;

  if (reviewsTrack && previousReviewButton && nextReviewButton) {
    // Re-bind to non-nullable consts so closures can use them safely
    const track = reviewsTrack;
    const prevBtn = previousReviewButton;
    const nextBtn = nextReviewButton;

    /** Scroll by one card width (first card measured). */
    function getScrollAmount(): number {
      const firstCard = track.querySelector("li");

      if (!firstCard) return 300;

      // Card width + gap (gap is 2rem = 32px at default font-size)
      return firstCard.offsetWidth + 32;
    }

    function updateArrows(): void {
      const { scrollLeft, scrollWidth, clientWidth } = track;

      prevBtn.disabled = scrollLeft <= 1;
      nextBtn.disabled = scrollLeft + clientWidth >= scrollWidth - 1;
    }

    prevBtn.addEventListener("click", () => {
      track.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
    });

    nextBtn.addEventListener("click", () => {
      track.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
    });

    track.addEventListener("scroll", updateArrows, { passive: true });

    window.addEventListener("resize", updateArrows, { passive: true });

    // Initial state
    updateArrows();

    // Read-more toggle via event delegation
    track.addEventListener("click", (event) => {
      const btn = (event.target as HTMLElement).closest(
        ".review-toggle",
      ) as HTMLButtonElement | null;

      if (!btn) return;

      const card = btn.closest("li");

      if (!card) return;

      const overflow = card.querySelector(".review-overflow");
      const ellipsis = card.querySelector(".review-ellipsis");

      if (!overflow) return;

      const isExpanded = btn.getAttribute("aria-expanded") === "true";
      const COLLAPSE_DURATION = 300;

      if (isExpanded) {
        // Collapsing: start the height transition immediately, but delay
        // the ellipsis re-appearance and button label swap until the
        // collapse finishes. Otherwise the eye reads it as instant.
        overflow.setAttribute("data-state", "collapsed");
        overflow.setAttribute("aria-hidden", "true");
        btn.setAttribute("aria-expanded", "false");
        btn.disabled = true;

        window.setTimeout(() => {
          if (ellipsis) ellipsis.classList.remove("hidden");
          btn.textContent = "Read full review";
          btn.disabled = false;
        }, COLLAPSE_DURATION);
      } else {
        // Expanding: hide the ellipsis immediately so the text reads
        // as one continuous quote while the remainder slides into view.
        if (ellipsis) ellipsis.classList.add("hidden");
        overflow.setAttribute("data-state", "expanded");
        overflow.setAttribute("aria-hidden", "false");
        btn.setAttribute("aria-expanded", "true");
        btn.textContent = "Show less";
      }
    });
  }
</script>
