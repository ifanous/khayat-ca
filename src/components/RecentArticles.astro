---
import { Icon } from "astro-icon/components";

import { getLatestBlogPosts } from "../utils/blog";
import ArticleCard from "./ArticleCard.astro";

const latestPosts = await getLatestBlogPosts(3);
---

<section class="bg-background py-20" aria-labelledby="latest-articles-heading">
  <div class="max-w-container mx-auto px-6">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <h2
        class="text-primary mb-4 text-3xl font-bold md:text-4xl lg:text-5xl"
        id="latest-articles-heading"
      >
        Latest immigration updates
      </h2>
      <p class="text-secondary text-lg leading-8">
        What's changing at IRCC and the IRB, and what it means for your case.
      </p>
    </div>

    {
      latestPosts.length > 0 ? (
        <>
          <div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">
            {latestPosts.map((post) => (
              <ArticleCard headingLevel="h3" post={post} />
            ))}
          </div>

          <div class="mt-10 flex justify-center md:justify-end">
            <a
              class="text-accent focus-ring group inline-flex items-center gap-2 font-semibold no-underline"
              href="/blog"
            >
              View all articles
              <Icon
                class="ease-out-quart h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
                name="lucide:arrow-right"
                aria-hidden="true"
              />
            </a>
          </div>
        </>
      ) : (
        <p class="text-secondary m-0 text-lg">
          Articles are coming soon. Check back for immigration updates.
        </p>
      )
    }
  </div>
</section>
