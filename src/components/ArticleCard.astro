---
import { Image } from "astro:assets";

import { Icon } from "astro-icon/components";

import type { BlogPostPreview, HeadingLevel } from "../types/blog";
import { formatBlogDate, getBlogImageSource } from "../utils/blog";

interface Props {
  headingLevel?: HeadingLevel;
  post: BlogPostPreview;
}

const { headingLevel = "h2", post } = Astro.props as Props;
const publishedLabel = formatBlogDate(post.pubDate);
// Astro requires the component variable to start with a capital letter
// so the renderer treats it as a dynamic tag, not an HTML element.
// eslint-disable-next-line @typescript-eslint/naming-convention
const Heading = headingLevel;
const imageSrc = getBlogImageSource(post.slug);
---

<article
  class="surface-hairline hover:border-primary/20 group relative flex h-full flex-col overflow-hidden transition-colors duration-200"
>
  {
    imageSrc && (
      <div
        class="border-border-custom h-56 overflow-hidden border-b"
        aria-hidden="true"
      >
        <Image
          class="h-full w-full object-cover"
          alt=""
          src={imageSrc}
          decoding="async"
          loading="lazy"
          sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw"
          widths={[400, 600, 800]}
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-6">
    <p
      class="text-secondary m-0 text-sm font-medium tracking-[0.08em] uppercase"
    >
      <time datetime={new Date(post.pubDate).toISOString()}
        >{publishedLabel}</time
      >
    </p>

    <Heading class="text-primary mt-3 mb-4 text-2xl leading-tight font-bold">
      <a
        class="link-overlay hover:text-accent no-underline transition-colors duration-150"
        href={post.href}
      >
        {post.title}
      </a>
    </Heading>

    <p class="text-secondary mb-6 flex-1 text-base leading-7">
      {post.description}
    </p>

    <p
      class="text-accent ease-out-quart m-0 inline-flex items-center gap-2 font-semibold transition-transform duration-200 group-hover:translate-x-0.5"
      aria-hidden="true"
    >
      Read article
      <Icon
        class="ease-out-quart h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
        name="lucide:arrow-right"
        aria-hidden="true"
      />
    </p>
  </div>
</article>
