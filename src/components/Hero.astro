---
// Home hero (live).
//
// Composition: left column carries the claim, subtitle, CTA, and demoted
// credential row, and nothing else. The right column is a quiet
// surface-hairline panel carrying three real facts (office, hours, and
// working languages), so the first screen also answers "where is she?"
// and "can I reach her today?". No portrait here; the portrait lives
// in the About section so the two surfaces do not repeat themselves.
---

<section class="bg-background" id="home">
  <div class="mt-24 w-full pt-20 pb-20 lg:pt-28 lg:pb-24">
    <div class="max-w-container mx-auto px-6">
      <div
        class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16"
      >
        <!-- Left column: claim, byline, subtitle, CTA, demoted credential row. -->
        <div class="lg:col-span-7">
          <h1
            class="text-primary mb-3 text-4xl leading-[1.1] font-bold tracking-[-0.01em] text-balance md:text-5xl lg:text-6xl"
          >
            Canadian immigration and refugee matters, handled personally.
          </h1>

          <p class="text-secondary mb-10 text-base md:text-lg">
            Brigitte Khayat, RCIC-IRB
          </p>

          <p class="text-primary max-w-2xl text-xl leading-relaxed md:text-2xl">
            I prepare every application myself. Every time.
          </p>

          <nav class="mt-12" aria-label="Primary actions">
            <a
              class="btn-primary focus-ring inline-flex min-h-12 cursor-pointer items-center justify-center rounded-lg border-2 border-transparent px-8 py-4 font-semibold text-white transition-all duration-200"
              href="/#contact">Request a Consultation</a
            >
          </nav>

          <p
            class="text-secondary mt-8 text-xs font-semibold tracking-[0.18em] uppercase md:text-sm"
          >
            CICC-Licensed <span aria-hidden="true">·</span> IRB-Authorized
            <span aria-hidden="true">·</span> CAPIC Member
          </p>
        </div>

        <aside
          class="surface-hairline p-6 lg:col-span-5 lg:mt-2 lg:p-8"
          aria-label="Practice details"
        >
          <dl class="space-y-6">
            <div>
              <dt
                class="text-secondary text-xs font-semibold tracking-[0.12em] uppercase"
              >
                Office
              </dt>
              <dd class="text-primary mt-2 text-base leading-relaxed">
                295 Robinson St, Suite 100<br />
                Oakville, ON<br />
                <span class="text-secondary">
                  For clients across the GTA, Canada, and abroad.
                </span>
              </dd>
            </div>

            <div class="border-border-custom border-t pt-6">
              <dt
                class="text-secondary text-xs font-semibold tracking-[0.12em] uppercase"
              >
                Hours
              </dt>
              <dd class="text-primary mt-2 text-base leading-relaxed">
                Monday to Friday<br />
                9 am to 6 pm ET
              </dd>
            </div>

            <div class="border-border-custom border-t pt-6">
              <dt
                class="text-secondary text-xs font-semibold tracking-[0.12em] uppercase"
              >
                Working languages
              </dt>
              <dd class="text-primary mt-2 text-base leading-relaxed">
                English, French, Arabic, and Greek
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </div>
</section>
