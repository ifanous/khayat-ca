---
import { Icon } from "astro-icon/components";

import NavigationLink from "./NavigationLink.astro";

const navItems = [
  { href: "/#home", text: "Home" },
  { href: "/#about", text: "About" },
  { href: "/#services", text: "Services" },
  { href: "/#reviews", text: "Reviews" },
  { href: "/#contact", text: "Contact" },
  { href: "/blog", text: "Blog" },
];
---

<header
  class="site-header fixed top-0 right-0 left-0 z-1000 h-24 rounded-none transition-colors duration-200"
  id="site-header"
>
  <nav
    class="max-w-container mx-auto flex h-24 items-center justify-between px-6"
    aria-label="Primary navigation"
  >
    <!-- Logo -->
    <a class="focus-ring" href="/" aria-label="Go to homepage">
      <img
        class="logo h-12 w-auto sm:h-14 xl:h-21"
        alt="Brigitte Khayat Immigration & Refugee Consulting"
        src="/logos/icon-text-left-horizontal.svg"
      />
    </a>

    <!-- Desktop Navigation -->
    <ul class="m-0 hidden list-none gap-8 p-0 xl:flex" id="nav-desktop">
      {
        navItems.map((item) => (
          <li>
            <NavigationLink
              href={item.href}
              text={item.text}
              variant="desktop"
            />
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-4">
      <!-- Theme radiogroup (tablet & desktop): direct-pick light / dark / system -->
      <div
        class="bg-surface border-border-custom hidden gap-0.5 rounded-lg border p-0.5 md:flex"
        role="radiogroup"
        aria-label="Theme selection"
      >
        <button
          class="theme-btn focus-ring text-secondary hover:bg-muted hover:text-primary flex h-11 w-11 cursor-pointer items-center justify-center rounded border-none transition-colors duration-150"
          type="button"
          data-theme="light"
          role="radio"
          aria-checked="false"
          aria-label="Light theme"
          tabindex="-1"
        >
          <Icon class="h-4.5 w-4.5" name="lucide:sun" aria-hidden="true" />
        </button>
        <button
          class="theme-btn focus-ring text-secondary hover:bg-muted hover:text-primary flex h-11 w-11 cursor-pointer items-center justify-center rounded border-none transition-colors duration-150"
          type="button"
          data-theme="dark"
          role="radio"
          aria-checked="false"
          aria-label="Dark theme"
          tabindex="-1"
        >
          <Icon class="h-4.5 w-4.5" name="lucide:moon" aria-hidden="true" />
        </button>
        <button
          class="theme-btn focus-ring text-secondary hover:bg-muted hover:text-primary flex h-11 w-11 cursor-pointer items-center justify-center rounded border-none transition-colors duration-150"
          type="button"
          data-theme="system"
          role="radio"
          aria-checked="true"
          aria-label="System theme"
          tabindex="0"
        >
          <Icon class="h-4.5 w-4.5" name="lucide:monitor" aria-hidden="true" />
        </button>
      </div>

      <!-- Theme cycle button (phone only): one-tap cycle system → light → dark … -->
      <button
        class="theme-cycle-btn text-secondary hover:bg-muted hover:text-primary focus-ring flex h-11 w-11 cursor-pointer items-center justify-center rounded-lg border-none bg-transparent transition-colors duration-150 md:hidden"
        id="theme-cycle-btn"
        type="button"
        data-current-theme="system"
        aria-label="Theme: System. Click to switch to Light."
      >
        <Icon
          class="theme-cycle-icon h-4.5 w-4.5"
          name="lucide:sun"
          data-theme-icon="light"
          aria-hidden="true"
        />
        <Icon
          class="theme-cycle-icon h-4.5 w-4.5"
          name="lucide:moon"
          data-theme-icon="dark"
          aria-hidden="true"
        />
        <Icon
          class="theme-cycle-icon h-4.5 w-4.5"
          name="lucide:monitor"
          data-theme-icon="system"
          aria-hidden="true"
        />
      </button>

      <!-- Mobile Menu Toggle -->
      <button
        class="text-primary hover:bg-muted focus-ring flex h-11 w-11 cursor-pointer items-center justify-center rounded-lg border-none bg-transparent transition-colors duration-200 xl:hidden"
        id="mobile-menu-toggle"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle menu"
      >
        <Icon class="h-6 w-6" name="lucide:menu" aria-hidden="true" />
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    class="bg-background border-border-custom hidden border-t px-6 pb-6 xl:hidden"
    id="mobile-menu"
    aria-hidden="true"
  >
    <nav class="flex flex-col gap-1 pt-4" aria-label="Mobile navigation">
      {
        navItems.map((item) => (
          <NavigationLink href={item.href} text={item.text} variant="mobile" />
        ))
      }
    </nav>
  </div>
</header>

<script>
  import {
    APPEARANCES,
    applyTheme,
    getStoredPreferredAppearance,
    setStoredPreferredAppearance,
  } from "../utils/theme";

  // --- Scroll-shadow on header ---
  const siteHeader = document.getElementById("site-header");

  if (siteHeader) {
    let ticking = false;
    const applyScrollClass = (): void => {
      siteHeader.classList.toggle("is-scrolled", window.scrollY > 8);
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(applyScrollClass);
          ticking = true;
        }
      },
      { passive: true },
    );
    applyScrollClass();
  }

  // --- Theme controls: desktop radiogroup + mobile cycle button stay in sync. ---
  const THEME_CYCLE = ["system", "light", "dark"] as const;

  type ThemeName = (typeof THEME_CYCLE)[number];

  const themeLabels: Record<ThemeName, string> = {
    system: "System",
    light: "Light",
    dark: "Dark",
  };

  const isThemeName = (value: string): value is ThemeName =>
    (THEME_CYCLE as readonly string[]).includes(value);

  const nextThemeAfter = (theme: ThemeName): ThemeName => {
    const i = THEME_CYCLE.indexOf(theme);

    return THEME_CYCLE[(i + 1) % THEME_CYCLE.length] ?? "system";
  };

  const themeButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".theme-btn"),
  );
  const cycleButton =
    document.querySelector<HTMLButtonElement>("#theme-cycle-btn");

  const updateAllThemeUI = (theme: ThemeName): void => {
    // Radiogroup (desktop): mark the matching radio, set roving tabindex.
    themeButtons.forEach((btn) => {
      const isActive = btn.getAttribute("data-theme") === theme;

      btn.setAttribute("aria-checked", String(isActive));
      btn.tabIndex = isActive ? 0 : -1;
    });

    // Cycle button (mobile): swap icon and update aria-label.
    if (cycleButton) {
      cycleButton.setAttribute("data-current-theme", theme);

      const next = nextThemeAfter(theme);

      cycleButton.setAttribute(
        "aria-label",
        `Theme: ${themeLabels[theme]}. Click to switch to ${themeLabels[next]}.`,
      );
    }
  };

  const setTheme = (theme: ThemeName, { persist }: { persist: boolean }) => {
    if (persist) setStoredPreferredAppearance(theme);
    applyTheme(theme);
    updateAllThemeUI(theme);
  };

  const initialPreferred = getStoredPreferredAppearance();
  const initialTheme: ThemeName =
    APPEARANCES.includes(initialPreferred) && isThemeName(initialPreferred)
      ? initialPreferred
      : "system";

  setTheme(initialTheme, { persist: false });

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", () => {
      if (getStoredPreferredAppearance() === "system") {
        applyTheme("system");
      }
    });

  // Desktop radiogroup: click + arrow-key navigation, scoped to its group.
  themeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const theme = btn.getAttribute("data-theme");

      if (theme && isThemeName(theme)) setTheme(theme, { persist: true });
    });

    btn.addEventListener("keydown", (event: KeyboardEvent) => {
      const { key } = event;

      if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(key)) {
        return;
      }

      event.preventDefault();

      const group = btn.closest<HTMLElement>('[role="radiogroup"]');

      if (!group) return;

      const groupButtons = Array.from(
        group.querySelectorAll<HTMLButtonElement>(".theme-btn"),
      );
      const currentIndex = groupButtons.indexOf(btn);
      const nextIndex =
        key === "ArrowLeft" || key === "ArrowUp"
          ? (currentIndex - 1 + groupButtons.length) % groupButtons.length
          : (currentIndex + 1) % groupButtons.length;

      const nextButton = groupButtons[nextIndex];
      const nextTheme = nextButton?.getAttribute("data-theme");

      if (nextButton && nextTheme && isThemeName(nextTheme)) {
        nextButton.focus();
        setTheme(nextTheme, { persist: true });
      }
    });
  });

  // Mobile cycle button: one-tap advance through system → light → dark.
  cycleButton?.addEventListener("click", () => {
    const current = cycleButton.getAttribute("data-current-theme");
    const currentTheme: ThemeName =
      current && isThemeName(current) ? current : "system";

    setTheme(nextThemeAfter(currentTheme), { persist: true });
  });

  // --- Mobile Menu ---
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  const menuButton = document.querySelector<HTMLButtonElement>(
    "#mobile-menu-toggle",
  );

  if (menu && menuButton) {
    const closeMenu = (): void => {
      menu.classList.add("hidden");
      menu.setAttribute("aria-hidden", "true");
      menuButton.setAttribute("aria-expanded", "false");
    };

    const openMenu = (): void => {
      menu.classList.remove("hidden");
      menu.setAttribute("aria-hidden", "false");
      menuButton.setAttribute("aria-expanded", "true");
      menu.querySelector<HTMLAnchorElement>("a")?.focus();
    };

    menuButton.addEventListener("click", () => {
      menu.classList.contains("hidden") ? openMenu() : closeMenu();
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => closeMenu());
    });

    document.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "Escape" && !menu.classList.contains("hidden")) {
        closeMenu();
        menuButton.focus();
      }
    });
  }

  // --- Nav & Section references (shared by scroll + click) ---
  const sections = document.querySelectorAll<HTMLElement>("section[id]");
  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
  const currentPathname = window.location.pathname;
  const isHomePage = currentPathname === "/";
  const isBlogRoute = currentPathname.startsWith("/blog");

  const getLinkURL = (link: HTMLAnchorElement): URL =>
    new URL(link.getAttribute("href") || link.href, window.location.origin);

  const getLinkHash = (link: HTMLAnchorElement): string =>
    getLinkURL(link).hash;

  const isHomeSectionLink = (link: HTMLAnchorElement): boolean => {
    const url = getLinkURL(link);

    return url.pathname === "/" && url.hash.length > 1;
  };

  const setActiveLink = (
    predicate: (link: HTMLAnchorElement) => boolean,
  ): void => {
    navLinks.forEach((link) => {
      const isActive = predicate(link);

      link.classList.toggle("active", isActive);

      if (isActive) {
        link.setAttribute("aria-current", "location");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  };

  // --- Active Nav Link on Scroll (IntersectionObserver) ---
  if (isHomePage && sections.length && navLinks.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");

            if (!id) return;

            setActiveLink(
              (link) =>
                isHomeSectionLink(link) && getLinkHash(link) === `#${id}`,
            );
          }
        });
      },
      { threshold: 0.3, rootMargin: "-80px 0px -40% 0px" },
    );

    for (const section of sections) {
      observer.observe(section);
    }
  } else if (isBlogRoute && navLinks.length) {
    setActiveLink((link) => getLinkURL(link).pathname === "/blog");
  }
</script>
