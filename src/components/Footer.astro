---
import { Image } from "astro:assets";

import { Icon } from "astro-icon/components";

import capicLogo from "../assets/credentials/capic-logo.png";
import rcicDark from "../assets/credentials/rcic-dark.png";
import rcicLight from "../assets/credentials/rcic-light.png";

const currentYear = new Date().getFullYear();
---

<footer class="bg-background pt-20 pb-8">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="col-span-1 md:col-span-2 lg:col-span-2">
        <a
          class="focus-ring inline-block"
          href="/#home"
          aria-label="Go to home section"
        >
          <img
            class="footer-logo mb-4 h-16 w-auto sm:h-20 lg:h-24"
            alt="Brigitte Khayat Immigration Consulting"
            src="/logos/icon-text-left-horizontal.svg"
          />
        </a>
        <p class="text-secondary max-w-md">
          I'm a licensed RCIC-IRB based in Oakville, working with individuals
          and families across the GTA, elsewhere in Canada, and abroad on
          Canadian immigration and refugee matters.
        </p>
      </div>

      <!-- Quick Links -->
      <nav aria-label="Footer navigation">
        <h2 class="text-primary mb-4 text-lg font-semibold">Quick links</h2>
        <ul class="list-none space-y-2 p-0">
          <li>
            <a
              class="text-secondary hover:text-accent focus-ring no-underline transition-colors duration-150"
              href="/#about">About Brigitte</a
            >
          </li>
          <li>
            <a
              class="text-secondary hover:text-accent focus-ring no-underline transition-colors duration-150"
              href="/#services">Services</a
            >
          </li>
          <li>
            <a
              class="text-secondary hover:text-accent focus-ring no-underline transition-colors duration-150"
              href="/#reviews">Client Reviews</a
            >
          </li>
          <li>
            <a
              class="text-secondary hover:text-accent focus-ring no-underline transition-colors duration-150"
              href="/#contact">Contact</a
            >
          </li>
          <li>
            <a
              class="text-secondary hover:text-accent focus-ring no-underline transition-colors duration-150"
              href="/blog">Immigration Blog</a
            >
          </li>
        </ul>
      </nav>

      <!-- Connect -->
      <div>
        <h2 class="text-primary mb-4 text-lg font-semibold">Connect</h2>
        <div class="mb-4 flex gap-4">
          <a
            class="bg-muted border-border-custom text-secondary hover:bg-accent focus-ring flex h-11 w-11 items-center justify-center rounded-full border transition-colors duration-200 hover:text-white"
            href="https://www.facebook.com/BK.RCIC"
            rel="noopener noreferrer"
            target="_blank"
            aria-label="Facebook (opens in a new tab)"
          >
            <Icon
              class="h-5 w-5"
              name="simple-icons:facebook"
              aria-hidden="true"
            />
          </a>
          <a
            class="bg-muted border-border-custom text-secondary hover:bg-accent focus-ring flex h-11 w-11 items-center justify-center rounded-full border transition-colors duration-200 hover:text-white"
            href="https://www.instagram.com/bk_rcic/"
            rel="noopener noreferrer"
            target="_blank"
            aria-label="Instagram (opens in a new tab)"
          >
            <Icon
              class="h-5 w-5"
              name="simple-icons:instagram"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </div>

    <!-- Footer Bottom: Badges & Copyright. -->
    <div
      class="border-border-custom mt-8 flex flex-col items-center justify-between gap-8 border-t pt-10 lg:flex-row lg:items-end"
    >
      <div class="flex flex-col items-center gap-8 sm:flex-row sm:gap-10">
        <!-- RCIC Insignia (theme-swapped: light variant for light theme, dark for dark) -->
        <a
          class="focus-ring inline-flex"
          href="https://register.college-ic.ca/Public-Register-EN/Licensee/Profile.aspx?ID=15757"
          rel="noopener noreferrer"
          target="_blank"
          aria-label="Verify CICC licence R533681 (opens in a new tab)"
        >
          <Image
            class="light-only h-20 w-auto object-contain"
            alt="RCIC Certified"
            src={rcicLight}
            decoding="async"
            densities={[1, 2]}
            loading="lazy"
          />
          <Image
            class="dark-only h-20 w-auto object-contain"
            alt="RCIC Certified"
            src={rcicDark}
            decoding="async"
            densities={[1, 2]}
            loading="lazy"
          />
        </a>
        <!-- CAPIC logo -->
        <a
          class="focus-ring inline-flex"
          href="https://www.capic.ca/EN/ActiveMembersList"
          rel="noopener noreferrer"
          target="_blank"
          aria-label="Verify CAPIC membership (opens in a new tab)"
        >
          <Image
            class="h-20 w-auto object-contain"
            alt="CAPIC Member"
            src={capicLogo}
            decoding="async"
            densities={[1, 2]}
            loading="lazy"
          />
        </a>
      </div>
      <div class="text-center lg:text-right">
        <p class="text-secondary m-0 text-sm">
          &copy; {currentYear} Brigitte Khayat - Immigration &amp; Refugee Consulting
          Inc. All rights reserved.
        </p>
        <p class="text-secondary m-0 mt-2 text-xs">
          Site built by <a
            class="hover:text-accent focus-ring underline-offset-2 hover:underline"
            href="https://www.ifanous.com"
            rel="noopener noreferrer"
            target="_blank"
            aria-label="iFanous Inc. (opens in a new tab)">iFanous Inc.</a
          >
        </p>
      </div>
    </div>
  </div>
</footer>
