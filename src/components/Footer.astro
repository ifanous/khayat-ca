---
import { Icon } from "astro-icon/components";

const currentYear = new Date().getFullYear();
---

<footer class="bg-background py-16 pb-8">
  <div class="max-w-container mx-auto px-6">
    <div
      class="glass mb-12 grid grid-cols-1 gap-12 rounded-lg p-8 transition-all duration-300 hover:-translate-y-0.5 md:grid-cols-2 lg:grid-cols-4"
    >
      <!-- Brand -->
      <div class="col-span-1 md:col-span-2 lg:col-span-2">
        <a href="/#home" aria-label="Go to home section">
          <img
            class="footer-logo mb-4 h-16 w-auto sm:h-20 lg:h-24"
            alt="Brigitte Khayat Immigration Consulting"
            src="/logos/icon-text-left-horizontal.svg"
          />
        </a>
        <p class="text-secondary mb-6">
          Licensed immigration consultant helping individuals and families
          achieve their Canadian goals with professional expertise and personal
          care.
        </p>
      </div>

      <!-- Quick Links -->
      <nav aria-label="Footer navigation">
        <h4 class="text-primary mb-4 text-lg font-semibold">Quick Links</h4>
        <ul class="list-none space-y-2 p-0">
          <li>
            <a
              class="text-secondary hover:text-accent no-underline transition-colors duration-150"
              href="/#about">About Brigitte</a
            >
          </li>
          <li>
            <a
              class="text-secondary hover:text-accent no-underline transition-colors duration-150"
              href="/#services">Services</a
            >
          </li>
          <li>
            <a
              class="text-secondary hover:text-accent no-underline transition-colors duration-150"
              href="/#reviews">Client Reviews</a
            >
          </li>
          <li>
            <a
              class="text-secondary hover:text-accent no-underline transition-colors duration-150"
              href="/#contact">Contact Us</a
            >
          </li>
          <li>
            <a
              class="text-secondary hover:text-accent no-underline transition-colors duration-150"
              href="/blog">Immigration Blog</a
            >
          </li>
        </ul>
      </nav>

      <!-- Connect -->
      <div>
        <h4 class="text-primary mb-4 text-lg font-semibold">Connect</h4>
        <div class="mb-4 flex gap-4">
          <a
            class="bg-muted border-border-custom text-secondary hover:bg-accent flex h-11 w-11 items-center justify-center rounded-full border transition-all duration-200 hover:-translate-y-0.5 hover:text-white"
            href="https://www.facebook.com/BK.RCIC"
            rel="noopener noreferrer"
            target="_blank"
            aria-label="Facebook (opens in a new tab)"
          >
            <Icon
              class="h-5 w-5"
              name="simple-icons:facebook"
              aria-hidden="true"
            />
          </a>
          <a
            class="bg-muted border-border-custom text-secondary hover:bg-accent flex h-11 w-11 items-center justify-center rounded-full border transition-all duration-200 hover:-translate-y-0.5 hover:text-white"
            href="https://www.instagram.com/bk_rcic/"
            rel="noopener noreferrer"
            target="_blank"
            aria-label="Instagram (opens in a new tab)"
          >
            <Icon
              class="h-5 w-5"
              name="simple-icons:instagram"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </div>

    <!-- Footer Bottom — Badges &amp; Copyright -->
    <div
      class="border-border-custom flex flex-col items-center justify-between gap-6 border-t pt-8 lg:flex-row"
    >
      <div class="flex flex-col items-center gap-6 sm:flex-row sm:gap-8">
        <!-- RCIC Insignia -->
        <img
          class="light-only h-20 w-auto object-contain"
          alt="RCIC Certified"
          src="/rcic-insignia/light.png"
        />
        <img
          class="dark-only h-20 w-auto object-contain"
          alt="RCIC Certified"
          src="/rcic-insignia/dark.png"
        />
        <!-- CAPIC logo -->
        <img
          class="h-20 w-auto object-contain"
          alt="CAPIC Member"
          src="/capic/logo.png"
        />
      </div>
      <div class="text-center lg:text-right">
        <p class="text-secondary m-0 text-sm">
          &copy; {currentYear} Brigitte Khayat - Immigration &amp; Refugee Consulting.
          All rights reserved.
        </p>
        <p class="text-secondary/80 m-0 mt-2 text-xs">
          Site built by <a
            class="hover:text-accent underline-offset-2 hover:underline"
            href="https://www.ifanous.com"
            rel="noopener noreferrer"
            target="_blank"
            aria-label="iFanous Inc. (opens in a new tab)">iFanous Inc.</a
          >
        </p>
      </div>
    </div>
  </div>
</footer>
