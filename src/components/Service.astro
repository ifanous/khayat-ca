---
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  name: string;
  description: string;
  features: string[];
}

const { icon, name, description, features } = Astro.props as Props;
---

<li
  class="glass bg-surface rounded-lg p-8 transition-all duration-300 hover:-translate-y-1.5"
>
  <div class="text-accent mb-4 h-12 w-12">
    <Icon class="h-12 w-12" name={icon} aria-hidden="true" />
  </div>
  <h3 class="text-primary mb-4 text-2xl font-semibold">{name}</h3>
  <p class="text-secondary mb-6">
    {description}
  </p>
  <ul class="m-0 list-none space-y-2 p-0">
    {
      features.map((feature) => (
        <li class="text-secondary flex items-start gap-2">
          <span class="text-success font-semibold" aria-hidden="true">
            ✓
          </span>
          <span>{feature}</span>
        </li>
      ))
    }
  </ul>
</li>
