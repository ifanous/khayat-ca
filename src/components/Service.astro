---
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  name: string;
  description: string;
  features: string[];
}

const { icon, name, description, features } = Astro.props as Props;
---

<li class="border-border-custom border-b py-10 lg:py-14">
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
    <!-- Icon -->
    <div class="lg:col-span-3">
      <span
        class="text-accent inline-flex h-12 w-12 items-center justify-center"
      >
        <Icon class="h-12 w-12" name={icon} aria-hidden="true" />
      </span>
    </div>

    <!-- Name + description -->
    <div class="lg:col-span-5">
      <h3 class="text-primary mb-4 text-2xl font-semibold md:text-3xl">
        {name}
      </h3>
      <p class="text-secondary max-w-prose text-base leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Features -->
    <ul class="m-0 list-none space-y-3 p-0 lg:col-span-4">
      {
        features.map((feature) => (
          <li class="text-primary flex items-start gap-2.5 text-sm leading-relaxed">
            <Icon
              class="text-success mt-0.5 h-4 w-4 shrink-0"
              name="lucide:check"
              aria-hidden="true"
            />
            <span>{feature}</span>
          </li>
        ))
      }
    </ul>
  </div>
</li>
