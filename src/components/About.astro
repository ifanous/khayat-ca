---
// About (live).
//
// Hero owns the name and the "handled personally" claim; Hero panel owns
// the office, hours, and languages. About owns method and credentials.
// The H2/H3 are method-forward so this section does not re-introduce
// Brigitte or repeat the credential abbreviations carried above.

import { Image } from "astro:assets";

import { Icon } from "astro-icon/components";

import portrait from "../assets/headshot/transparent.png";

const credentials = [
  {
    text: "Licensed by CICC",
  },
  {
    text: "Authorized to represent clients before the IRB",
  },
  { text: "Bound by strict ethical and professional standards" },
  {
    text: "Member of CAPIC",
  },
];
---

<section
  class="bg-background py-16 lg:py-20"
  id="about"
  aria-labelledby="about-heading"
>
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12 text-center">
      <h2
        class="text-primary mb-4 text-3xl font-bold md:text-4xl lg:text-5xl"
        id="about-heading"
      >
        How I work
      </h2>
      <p class="text-secondary mx-auto max-w-2xl text-xl">
        Your case, read on its own facts.
      </p>
    </div>

    <div
      class="mx-auto grid max-w-5xl grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16"
    >
      <!-- Portrait -->
      <figure class="lg:col-span-5">
        <Image
          class="mx-auto w-full max-w-xs rounded-lg lg:max-w-none"
          alt="Portrait of Brigitte Khayat"
          src={portrait}
          decoding="async"
          loading="eager"
          sizes="(max-width: 1024px) 20rem, 26rem"
          widths={[320, 480, 640, 800]}
        />
      </figure>

      <!-- Bio -->
      <div class="lg:col-span-7">
        <div class="text-primary space-y-5 text-lg leading-relaxed">
          <p>
            My practice covers permanent residence, temporary permits,
            citizenship, and refugee matters. I work with individuals and
            families across the GTA, elsewhere in Canada, and abroad.
          </p>
          <p>
            For most clients, the stakes are large: whether a family stays
            together, or where a life gets built. Each file starts with a
            careful read of your facts. From there, I prepare your application
            or submissions and keep you in the loop at every step. Immigration
            decisions turn on detail, and detail is where I spend most of my
            time.
          </p>
        </div>

        <ul class="mt-10 space-y-3">
          {
            credentials.map((item) => (
              <li class="flex items-start gap-3">
                <Icon
                  class="text-success mt-1 h-5 w-5 shrink-0"
                  name="lucide:check"
                  aria-hidden="true"
                />
                <span class="text-primary">{item.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
