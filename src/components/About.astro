---
import { Icon } from "astro-icon/components";
---

<section class="bg-background py-20" id="about">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-16 text-center">
      <h2 class="text-primary mb-4 text-3xl font-bold md:text-4xl lg:text-5xl">
        Meet Brigitte Khayat
      </h2>
      <p class="text-secondary mx-auto max-w-2xl text-xl">
        Your trusted guide through the Canadian immigration process
      </p>
    </div>

    <div class="grid grid-cols-1 items-start gap-16 lg:grid-cols-3">
      <!-- Photo -->
      <div class="text-center lg:col-span-1">
        <div
          class="glass rounded-lg p-8 text-center transition-all duration-300 hover:-translate-y-1"
        >
          <img
            class="mx-auto w-full max-w-xs rounded-lg mix-blend-multiply dark:mix-blend-screen dark:brightness-95 dark:contrast-110"
            alt="Portrait of Brigitte Khayat"
            src="/headshot/transparent.png"
            decoding="async"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Bio -->
      <div class="lg:col-span-2">
        <div
          class="glass rounded-lg p-8 transition-all duration-300 hover:-translate-y-0.5"
        >
          <h3 class="text-primary mb-4 text-2xl font-semibold">
            Licensed &amp; Experienced
          </h3>
          <p class="text-primary mb-8">
            As a licensed Regulated Canadian Immigration Consultant (RCIC-IRB)
            based in the GTA, I support clients in Canada and abroad with
            thoughtful, personalized immigration and refugee consulting. My
            approach combines professional expertise, careful preparation, and
            attention to the unique details of every case.
          </p>

          <ul class="mb-8 space-y-4">
            <li class="flex items-start gap-3">
              <div class="text-success h-6 w-6 shrink-0">
                <Icon
                  class="h-5 w-5"
                  name="lucide:circle-check"
                  aria-hidden="true"
                />
              </div>
              <span class="text-primary"
                >Licensed by CICC &amp; member of CAPIC</span
              >
            </li>
            <li class="flex items-start gap-3">
              <div class="text-success h-6 w-6 shrink-0">
                <Icon
                  class="h-5 w-5"
                  name="lucide:circle-check"
                  aria-hidden="true"
                />
              </div>
              <span class="text-primary"
                >Authorized to represent clients before IRB</span
              >
            </li>
            <li class="flex items-start gap-3">
              <div class="text-success h-6 w-6 shrink-0">
                <Icon
                  class="h-5 w-5"
                  name="lucide:circle-check"
                  aria-hidden="true"
                />
              </div>
              <span class="text-primary"
                >Strict ethical &amp; professional standards</span
              >
            </li>
          </ul>

          <p class="text-primary">
            I strive to provide personalized, high-quality immigration and
            refugee consulting services, helping you navigate the complex
            Canadian immigration system with confidence and peace of mind.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
