---
import { Image } from "astro:assets";

import Contact from "../components/Contact.astro";
import type { BlogFrontmatter } from "../types/blog";
import { formatBlogDate, getBlogImageSource } from "../utils/blog";
import SiteLayout from "./SiteLayout.astro";

interface Props extends Partial<BlogFrontmatter> {
  frontmatter?: BlogFrontmatter;
}

const frontmatter = (Astro.props.frontmatter ?? Astro.props) as BlogFrontmatter;
const { title, description, image, pubDate, author, tags } = frontmatter;

const slug = Astro.url.pathname.replace(/^\/blog\//, "").replace(/\/$/, "");
const imageSrc = getBlogImageSource(slug);
const publishedISO = new Date(pubDate).toISOString();
const publishedLabel = formatBlogDate(pubDate);
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: publishedISO,
  ...(author && { author: { "@type": "Person", name: author } }),
  ...(imageSrc && { image: new URL(image?.url ?? "", Astro.site).href }),
  url: canonicalURL,
});
---

<SiteLayout
  title={title}
  article={{
    publishedTime: publishedISO,
    author,
    tags,
  }}
  description={description}
  ogType="article"
>
  <article class="pt-32 pb-7 sm:pt-38">
    <div class="mx-auto w-full max-w-208 px-6">
      <!-- Breadcrumb -->
      <nav class="text-secondary mb-6 text-sm" aria-label="Breadcrumb">
        <ol class="m-0 flex list-none flex-wrap items-center gap-1 p-0">
          <li>
            <a
              class="text-accent hover:text-primary no-underline transition-colors duration-150"
              href="/blog"
            >
              Blog
            </a>
          </li>
          <li class="text-secondary" aria-hidden="true">/</li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="mb-8">
        <h1
          class="text-primary mb-4 text-[clamp(2.25rem,5vw,3.5rem)] leading-[1.2] font-extrabold tracking-[-0.02em] text-balance"
        >
          {title}
        </h1>
        {
          pubDate && (
            <p class="text-secondary m-0 text-base">
              <time datetime={publishedISO}>{publishedLabel}</time>
              {author && <span> · {author}</span>}
            </p>
          )
        }
      </header>

      {
        imageSrc && (
          <Image
            class="border-border-custom mb-8 block w-full rounded-2xl border shadow-lg"
            alt={image?.alt || title}
            src={imageSrc}
            decoding="async"
            fetchpriority="high"
            loading="eager"
            sizes="(max-width: 640px) 100vw, 52rem"
            widths={[640, 832, 1200]}
          />
        )
      }

      <!-- Article content -->
      <div
        class="article-content text-primary text-[1.0625rem] leading-[1.8] sm:text-base sm:leading-[1.75]"
      >
        <slot />
      </div>
    </div>
  </article>

  <Contact />

  <script type="application/ld+json" set:html={jsonLd} />
</SiteLayout>

<style>
  .article-content > :first-child {
    margin-top: 0;
  }

  .article-content > :last-child {
    margin-bottom: 0;
  }

  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    color: var(--ao-fg);
    text-wrap: balance;
    line-height: 1.2;
    letter-spacing: -0.02em;
    scroll-margin-top: 7rem;
  }

  .article-content :global(h2) {
    margin: 3rem 0 1rem;
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .article-content :global(h3) {
    margin: 2rem 0 0.75rem;
    font-weight: 700;
    font-size: 1.25rem;
  }

  .article-content :global(p),
  .article-content :global(ul),
  .article-content :global(ol),
  .article-content :global(blockquote),
  .article-content :global(pre) {
    margin: 1.25rem 0;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    padding-left: 1.5rem;
  }

  .article-content :global(ul) {
    list-style: disc;
  }

  .article-content :global(ol) {
    list-style: decimal;
  }

  .article-content :global(li + li) {
    margin-top: 0.75rem;
  }

  .article-content :global(a) {
    color: var(--ao-blue);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  .article-content :global(a:hover) {
    color: var(--ao-cyan);
  }

  .article-content :global(strong) {
    color: var(--ao-fg);
    font-weight: 700;
  }

  .article-content :global(blockquote) {
    margin-left: 0;
    padding: 1rem 1.25rem;
    color: var(--ao-comment);
    background: var(--ao-bg-alt);
    border-left: 4px solid var(--ao-blue);
    border-radius: 0.75rem;
  }

  .article-content :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--ao-border);
  }

  .article-content :global(code) {
    padding: 0.15rem 0.4rem;
    font-size: 0.9em;
    background: var(--ao-bg-alt);
    border: 1px solid var(--ao-border);
    border-radius: 0.375rem;
  }

  .article-content :global(pre) {
    padding: 1rem 1.25rem;
    background: var(--ao-bg-alt);
    border: 1px solid var(--ao-border);
    border-radius: 1rem;
    overflow-x: auto;
  }

  .article-content :global(pre code) {
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .article-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2rem auto;
    border-radius: 1rem;
  }
</style>
