---
import Contact from "../components/Contact.astro";
import type { BlogFrontmatter } from "../types/blog";
import { formatBlogDate, getBlogImageSource } from "../utils/blog";
import SiteLayout from "./SiteLayout.astro";

interface Props extends Partial<BlogFrontmatter> {
  frontmatter?: BlogFrontmatter;
}

const frontmatter = (Astro.props.frontmatter ?? Astro.props) as BlogFrontmatter;
const { title, description, image, pubDate, updatedDate, author, tags } =
  frontmatter;

const slug = Astro.url.pathname.replace(/^\/blog\//, "").replace(/\/$/, "");
const ogImageSrc = getBlogImageSource(slug);
const publishedISO = new Date(pubDate).toISOString();
const modifiedISO = updatedDate
  ? new Date(updatedDate).toISOString()
  : publishedISO;
const publishedLabel = formatBlogDate(pubDate);
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const siteOrigin = new URL("/", Astro.site).href.replace(/\/$/, "");

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: publishedISO,
  dateModified: modifiedISO,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL,
  },
  ...(author && {
    author: {
      "@type": "Person",
      name: author,
      jobTitle: "Regulated Canadian Immigration Consultant (RCIC-IRB)",
      url: `${siteOrigin}/#business`,
    },
  }),
  publisher: {
    "@type": "ProfessionalService",
    "@id": `${siteOrigin}/#business`,
    name: "Brigitte Khayat - Immigration & Refugee Consulting",
    logo: {
      "@type": "ImageObject",
      url: new URL("/logos/icon-text-left-horizontal.png", Astro.site).href,
      width: 600,
      height: 191,
    },
  },
  ...(ogImageSrc && { image: new URL(image?.url ?? "", Astro.site).href }),
  ...(tags && tags.length > 0 && { keywords: tags.join(", ") }),
  url: canonicalURL,
});
---

<SiteLayout
  title={title}
  article={{
    publishedTime: publishedISO,
    author,
    tags,
  }}
  description={description}
  ogImage={image?.url}
  ogType="article"
>
  <article class="pt-28 pb-8">
    <div class="mx-auto w-full max-w-2xl px-6">
      <!-- Breadcrumb. -->
      <nav class="text-secondary mb-6 text-sm" aria-label="Breadcrumb">
        <ol class="m-0 flex list-none flex-nowrap items-center gap-1 p-0">
          <li class="shrink-0">
            <a
              class="text-secondary hover:text-primary focus-ring no-underline transition-colors duration-150"
              href="/blog"
            >
              Blog
            </a>
          </li>
          <li class="text-secondary shrink-0" aria-hidden="true">/</li>
          <li class="min-w-0 flex-1 truncate" title={title} aria-current="page">
            {title}
          </li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="mb-10">
        <h1
          class="text-primary mb-4 text-[clamp(2rem,4vw,3rem)] leading-[1.15] font-bold tracking-[-0.01em] text-balance"
        >
          {title}
        </h1>
        {
          pubDate && (
            <p class="text-secondary m-0 text-sm">
              <time datetime={publishedISO}>{publishedLabel}</time>
              {author && <span> · {author}</span>}
            </p>
          )
        }
      </header>

      <!-- Article content -->
      <div class="article-content text-primary text-[1.125rem] leading-[1.7]">
        <slot />
      </div>

      <!-- Author bridge -->
      <aside
        class="border-border-custom text-secondary mt-10 border-t pt-8 text-[1.125rem] leading-[1.7] italic"
        aria-label="About the author"
      >
        Brigitte Khayat, RCIC-IRB. I write here when immigration rules shift in
        ways that change the shape of real cases. If yours is affected, or
        you're not sure whether it is, the form below will reach me.
      </aside>
    </div>
  </article>

  <Contact />

  <script type="application/ld+json" set:html={jsonLd} />
</SiteLayout>
