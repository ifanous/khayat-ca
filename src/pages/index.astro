---
import Main from "../components/Main.astro";
import reviewsData from "../data/google-reviews.json";
import SiteLayout from "../layouts/SiteLayout.astro";
import type { ReviewsData } from "../types/reviews";

const siteUrl = "https://khayat.ca";

const { summary } = reviewsData as ReviewsData;

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": ["ProfessionalService", "LegalService"],
  "@id": `${siteUrl}/#business`,
  name: "Brigitte Khayat - Immigration & Refugee Consulting Inc.",
  url: siteUrl,
  image: `${siteUrl}/og-image.png`,
  logo: `${siteUrl}/favicon.svg`,
  description:
    "Licensed RCIC-IRB providing immigration and refugee consulting services for individuals and families across the Greater Toronto Area and beyond.",
  founder: {
    "@type": "Person",
    name: "Brigitte Khayat",
    jobTitle: "Regulated Canadian Immigration Consultant (RCIC-IRB)",
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: "295 Robinson St Suite 100",
    addressLocality: "Oakville",
    addressRegion: "ON",
    postalCode: "L6J 1G7",
    addressCountry: "CA",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 43.447513194689826,
    longitude: -79.66539470674623,
  },
  areaServed: [
    { "@type": "AdministrativeArea", name: "Greater Toronto Area" },
    { "@type": "City", name: "Toronto" },
    { "@type": "City", name: "Mississauga" },
    { "@type": "City", name: "Brampton" },
    { "@type": "City", name: "Vaughan" },
    { "@type": "City", name: "Markham" },
    { "@type": "City", name: "Richmond Hill" },
    { "@type": "City", name: "Oakville" },
    { "@type": "City", name: "Milton" },
    { "@type": "City", name: "Burlington" },
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "https://schema.org/Monday",
        "https://schema.org/Tuesday",
        "https://schema.org/Wednesday",
        "https://schema.org/Thursday",
        "https://schema.org/Friday",
      ],
      opens: "09:00",
      closes: "18:00",
    },
  ],
  availableLanguage: ["English", "French", "Arabic", "Greek"],
  telephone: "+1-437-370-1850",
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: summary.averageRating,
    ratingCount: summary.reviewCount,
    bestRating: 5,
    worstRating: 1,
  },
  sameAs: [
    // Official CICC public register entry for Brigitte. This is the
    // single strongest E-E-A-T signal for a regulated profession: a
    // verifiable link from the site to the regulator's own record.
    "https://register.college-ic.ca/Public-Register-EN/Licensee/Profile.aspx?ID=15757",
    // CAPIC publishes only a searchable member list (no per-member
    // permalink), so we link to the active members list as proof of
    // membership rather than a deep link.
    "https://www.capic.ca/EN/ActiveMembersList",
    // Canonical Google Business Profile URL (resolved from place_id).
    "https://www.google.com/maps/place/?q=place_id:ChIJSyuuhA1vlKMRt1Pjpq8_qwg",
    "https://www.facebook.com/BK.RCIC",
    "https://www.instagram.com/bk_rcic/",
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Immigration Services",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Permanent Residence",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Temporary Residence",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Citizenship",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Refugee Protection",
        },
      },
    ],
  },
};

const professionalServiceSchemaJson = JSON.stringify(professionalServiceSchema);
---

<SiteLayout
  title="RCIC-IRB Immigration Consultant Serving the GTA | Brigitte Khayat"
  description="Licensed RCIC-IRB immigration consultant serving clients across the GTA, Canada, and abroad with help for PR, work permits, study permits, citizenship, and refugee matters."
>
  <script type="application/ld+json" set:html={professionalServiceSchemaJson} />
  <Main />
</SiteLayout>
