---
import ArticleCard from "../../components/ArticleCard.astro";
import Contact from "../../components/Contact.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getAllBlogPosts } from "../../utils/blog";

const allPosts = await getAllBlogPosts();
---

<SiteLayout
  title="Canadian Immigration News, Explained by an RCIC-IRB | Brigitte Khayat"
  description="Notes on IRCC rule changes and IRB decisions from Brigitte Khayat, RCIC-IRB, an immigration consultant serving clients across the GTA, Canada, and abroad."
>
  <section class="bg-background pt-40 pb-20" aria-labelledby="blog-heading">
    <div class="max-w-container mx-auto px-6">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h1
          class="text-primary mb-6 text-4xl font-bold md:text-5xl lg:text-6xl"
          id="blog-heading"
        >
          Canadian immigration news, explained by an RCIC-IRB
        </h1>
        <p class="text-secondary text-lg leading-8 md:text-xl">
          Notes on what's changing at IRCC and the IRB, and what it means for
          your case.
        </p>
      </div>

      {
        allPosts.length > 0 ? (
          <div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">
            {allPosts.map((post) => (
              <ArticleCard headingLevel="h2" post={post} />
            ))}
          </div>
        ) : (
          <div class="surface-hairline mx-auto max-w-2xl p-8 md:p-10">
            <h2 class="text-primary mb-3 text-2xl font-bold">
              No articles here yet.
            </h2>
            <p class="text-primary m-0 text-lg leading-relaxed">
              I post when immigration rules change in meaningful ways. If your
              question won't wait, the form below will reach me.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <Contact />
</SiteLayout>
